# ---------------------------------------------------------------------------
# The BikErGang — frontend .gitignore
# Ignores everything that is NOT frontend source: dependencies, build output,
# caches, secrets, generated bundles, tooling, and OS/editor cruft.
# Tracked: src/, public/, index.html, config files, README, docs/, screenshots/.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# Build output
dist/
dist-ssr/
build/
out/

# Vite / TypeScript / tooling caches
.vite/
*.tsbuildinfo
*.local

# Logs & debug
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment & secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key

# Generated submission bundles & build-staging artifacts (not source)
*.zip
/BikErGang_Frontend/
/BikErGang_Milestone1/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Tooling / local agent state (not part of the frontend)
.claude/

# Test / coverage (if added later)
coverage/
.nyc_output/
